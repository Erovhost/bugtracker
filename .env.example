# Образец настроек. Скопируйте в .env и подставьте свои значения.
# Файл .env в репозиторий не попадает (см. .gitignore).

# Секретный ключ Flask: подпись сессий и защита форм (CSRF).
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-random-string

# Подключение к PostgreSQL:
# postgresql+psycopg://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@СЕРВЕР:ПОРТ/ИМЯ_БАЗЫ
DATABASE_URL=postgresql+psycopg://bugtracker:your-password@localhost:5432/bugtracker
