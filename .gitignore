# Секреты: пароли, ключи, строки подключения к БД
.env

# Виртуальное окружение
venv/

# Кэш Python
__pycache__/
*.pyc

# Кэш тестов и линтера
.pytest_cache/
.ruff_cache/
test-results/

# Логи приложения
logs/
*.log

# Настройки редакторов
.vscode/
.idea/

# Резервные копии БД: содержат все данные и хэши паролей — никогда в Git
backups/
*.dump
